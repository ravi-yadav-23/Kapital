# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with asyncpg driver (Supabase session pooler or local instance)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kapitl
REDIS_URL=redis://localhost:6379/0

# ── App & Security ────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-secure-random-32-byte-secret
ADMIN_PIN=7090
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# ── Google OAuth & Access Control (Single-User Whitelist) ──────────────────────
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# ONLY this email is permitted to log in as Administrator. All others are blocked.
ALLOWED_EMAIL=your-whitelisted-email@gmail.com

# ── Google Authenticator (TOTP 2FA) ───────────────────────────────────────────
# Base32 secret for Google Authenticator. Leave empty on initial run to generate
# a new secret and display a one-time QR code on your screen during first login.
ADMIN_TOTP_SECRET=

# ── Angel One SmartAPI (Family Demat Accounts) ────────────────────────────────
# JSON array of family member accounts. Sensitive fields are encrypted at rest with Fernet.
ANGEL_ACCOUNTS_JSON=[{"name":"Self","relation":"Self","api_key":"your_api_key","client_id":"your_client_id","pin":"your_mpin","totp_secret":"your_base32_totp_secret"}]

# ── AI Due Diligence Providers ────────────────────────────────────────────────
# Get keys:
# - Groq: https://console.groq.com
# - Google Gemini: https://aistudio.google.com
# - Anthropic Claude: https://console.anthropic.com
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=openai/gpt-oss-120b

# ── Live IPO Market Data Feed ─────────────────────────────────────────────────
# Free API key from https://ipoalerts.in (Starter tier, no credit card needed)
IPOALERTS_API_KEY=

# ── NSE & Regulatory Compliance ───────────────────────────────────────────────
# Whitelisted static IP for Angel One SmartAPI trading execution
STATIC_IP=
